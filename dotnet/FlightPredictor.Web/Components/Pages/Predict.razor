@page "/predict"
@using FlightPredictor.Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject FlightApiClient ApiClient
@rendermode InteractiveServer

<PageTitle>Flight Delay Predictor</PageTitle>

<h1>✈️ Flight Delay Predictor</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Enter Flight Details</h5>
                
                <EditForm Model="@request" OnValidSubmit="@HandlePredict">
                    <div class="mb-3">
                        <label class="form-label">Origin Airport</label>
                        <InputText class="form-control" @bind-Value="request.OriginAirport" placeholder="ATL" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Destination Airport</label>
                        <InputText class="form-control" @bind-Value="request.DestinationAirport" placeholder="LAX" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Carrier</label>
                        <InputText class="form-control" @bind-Value="request.Carrier" placeholder="DL" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Month</label>
                            <InputNumber class="form-control" @bind-Value="request.Month" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Day</label>
                            <InputNumber class="form-control" @bind-Value="request.DayOfMonth" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Hour (0-23)</label>
                            <InputNumber class="form-control" @bind-Value="request.Hour" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Minute</label>
                            <InputNumber class="form-control" @bind-Value="request.Minute" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Predict Delay
                    </button>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        @if (prediction != null)
        {
            <div class="card @(prediction.IsDelayed ? "border-danger" : "border-success")">
                <div class="card-body">
                    <h5 class="card-title">Prediction Result</h5>
                    
                    <div class="alert @(prediction.IsDelayed ? "alert-danger" : "alert-success")" role="alert">
                        <h4>@(prediction.IsDelayed ? "⚠️ Likely Delayed" : "✅ Likely On-Time")</h4>
                        <p class="mb-0">@prediction.Message</p>
                    </div>

                    <div class="mt-3">
                        <strong>Probability:</strong> @prediction.Probability.ToString("P1")<br />
                        <strong>Confidence:</strong> @prediction.Confidence.ToString("P1")<br />
                        <strong>Predicted At:</strong> @prediction.PredictedAt.ToString("g")
                    </div>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <strong>Error:</strong> @errorMessage
            </div>
        }
    </div>
</div>

@code {
    private PredictionRequest request = new()
    {
        DayOfWeek = (int)DateTime.Now.DayOfWeek,
        Month = DateTime.Now.Month,
        DayOfMonth = DateTime.Now.Day,
        Hour = DateTime.Now.Hour,
        Minute = DateTime.Now.Minute,
        OriginAirport = "ATL",
        DestinationAirport = "LAX",
        Carrier = "DL"
    };

    private PredictionResponse? prediction;
    private string? errorMessage;
    private bool isLoading = false;

    private async Task HandlePredict()
    {
        isLoading = true;
        errorMessage = null;
        prediction = null;

        try
        {
            // Calculate day of week from the date
            var date = new DateTime(DateTime.Now.Year, request.Month, request.DayOfMonth);
            request.DayOfWeek = (int)date.DayOfWeek;

            prediction = await ApiClient.PredictAsync(request);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to get prediction: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}